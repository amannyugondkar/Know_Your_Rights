## 🚨 RISK DETECTION
@dataclass
class Risk:
    level: str
    category: str
    description: str
    suggestion: str

RISK_PATTERNS = [
    {"level": "CRITICAL", "category": "Unlimited Liability",
     "patterns": [r"unlimited\s+liability", r"indemnify.*?all\s+claims"],
     "description": "Unlimited financial risk",
     "suggestion": "Cap at contract value"},
    {"level": "CRITICAL", "category": "Irrevocable",
     "patterns": [r"irrevocable", r"cannot.*?terminated"],
     "description": "Cannot exit agreement",
     "suggestion": "Add termination clause"},
    {"level": "HIGH", "category": "Unilateral Termination",
     "patterns": [r"terminate.*?without\s+cause", r"sole\s+discretion"],
     "description": "Can terminate anytime",
     "suggestion": "Request notice period"},
    {"level": "HIGH", "category": "Non-Compete",
     "patterns": [r"non-compete", r"not\s+compete"],
     "description": "Restricts employment",
     "suggestion": "Limit to 1-2 years"},
    {"level": "MEDIUM", "category": "Auto-Renewal",
     "patterns": [r"automatically\s+renew"],
     "description": "Renews unless cancelled",
     "suggestion": "Mark calendar"},
    {"level": "MEDIUM", "category": "IP Ownership",
     "patterns": [r"intellectual\s+property.*?belong"],
     "description": "Transfers IP rights",
     "suggestion": "Clarify scope"},
    {"level": "LOW", "category": "Governing Law",
     "patterns": [r"governed\s+by.*?laws"],
     "description": "Specifies jurisdiction",
     "suggestion": "Verify acceptable"}
]

def detect_risks(text: str) -> List[Risk]:
    risks = []
    for pg in RISK_PATTERNS:
        for pat in pg["patterns"]:
            if re.search(pat, text.lower()) and not any(r.category == pg["category"] for r in risks):
                risks.append(Risk(pg["level"], pg["category"], pg["description"], pg["suggestion"]))
                break
    return risks

def calculate_risk_score(risks: List[Risk]) -> int:
    return min(100, sum({"CRITICAL":40,"HIGH":20,"MEDIUM":10,"LOW":5}.get(r.level,0) for r in risks))

