class RAGSystem:
    def __init__(self, knowledge: List[Dict]):
        print("🔄 Initializing RAG...")
        self.knowledge = knowledge
        self.texts = [item["text"] for item in knowledge]
        
        print(f"Loading {Config.EMBEDDING_MODEL}...")
        self.embedder = SentenceTransformer(Config.EMBEDDING_MODEL)
        
        print("Creating embeddings...")
        embeddings = self.embedder.encode(self.texts, show_progress_bar=True)
        
        self.index = faiss.IndexFlatL2(embeddings.shape[1])
        self.index.add(embeddings.astype('float32'))
        print(f"✅ RAG ready with {len(knowledge)} laws")
    
    def retrieve(self, query: str, k: int = 5) -> List[Dict]:
        query_emb = self.embedder.encode([query])
        _, indices = self.index.search(query_emb.astype('float32'), k)
        return [self.knowledge[i] for i in indices[0]]

rag = RAGSystem(LEGAL_KNOWLEDGE)
## 🤖 GEMINI AI ANALYZER
def analyze_with_gemini(document: str, query: str, risks: List[Risk], laws: List[Dict]) -> str:
    risks_text = "\n".join([f"{r.level} - {r.category}: {r.description}" for r in risks]) if risks else "No major risks."
    laws_text = "\n\n".join([f"{law['title']}:\n{law['text']}" for law in laws])
    
    prompt = f"""You are KnowRights AI legal assistant.

LEGAL CONTEXT:
{laws_text}

DOCUMENT:
{document[:2000]}

DETECTED RISKS:
{risks_text}

USER QUESTION:
{query}

Provide:
1. Summary
2. Legal issues (cite sections)
3. Risk assessment
4. Recommendations

Include disclaimer about consulting lawyer."""
    
    try:
        model = genai.GenerativeModel(Config.GEMINI_MODEL)
        response = model.generate_content(prompt, generation_config=genai.GenerationConfig(
            max_output_tokens=Config.MAX_OUTPUT_TOKENS, temperature=0.3))
        return response.text
    except Exception as e:
        return f"Error: {e}"

print("✅ Gemini analyzer ready")
## 🎯 COMPLETE PIPELINE
def analyze_contract(text: str = None, file_path: str = None, query: str = "Analyze this contract"):
    print("="*80)
    print("🏛️ KNOWRIGHTS - CONTRACT ANALYSIS")
    print("="*80)
    
    start = time.time()
    
    # 1. Get text
    print("\n📄 Step 1: Document Processing")
    if file_path:
        text = extract_text(file_path)
    elif not text:
        return print("❌ No document provided")
    print(f"✅ {len(text)} characters")
    
    # 2. Language
    print("\n🌍 Step 2: Language Detection")
    query_lang = detect_language(query)
    query_en = translate_text(query, query_lang, "en") if query_lang != "en" else query
    print(f"✅ Detected: {query_lang}")
    
    # 3. Risks
    print("\n🚨 Step 3: Risk Detection")
    risks = detect_risks(text)
    score = calculate_risk_score(risks)
    print(f"✅ {len(risks)} risks | Score: {score}/100")
    
    # 4. Legal retrieval
    print("\n📚 Step 4: Legal Retrieval")
    laws = rag.retrieve(query_en, k=5)
    print(f"✅ {len(laws)} laws")
    
    # 5. AI analysis
    print("\n🤖 Step 5: AI Analysis")
    analysis = analyze_with_gemini(text, query_en, risks, laws)
    print("✅ Complete")
    
    # 6. Translate back
    if query_lang != "en":
        print(f"\n🔄 Step 6: Translation")
        analysis = translate_text(analysis, "en", query_lang)
    
    # Display
    elapsed = time.time() - start
    print("\n" + "="*80)
    print(f"🎯 Risk Score: {score}/100")
    if score >= 80: print("🚨 EXTREME RISK")
    elif score >= 50: print("⚠️ HIGH RISK")
    elif score >= 20: print("⚠️ MODERATE RISK")
    else: print("✅ LOW RISK")
    
    print("\n📋 Risks:")
    for r in risks:
        print(f"{r.level}: {r.category} - {r.description}")
    
    print("\n🤖 AI ANALYSIS:\n")
    print(analysis)
    print("\n" + "="*80)
    print(f"⏱️ Time: {elapsed:.1f}s")
    print("="*80)
    
    return {'text': text, 'risks': risks, 'score': score, 'laws': laws, 'analysis': analysis}

print("✅ Pipeline ready!")
