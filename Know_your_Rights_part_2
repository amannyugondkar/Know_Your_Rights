## 💰 FINANCIAL IMPACT CALCULATOR
def calculate_financial_impact(contract_text: str, risks: List[Risk]) -> Dict:
    """Calculate 5-year financial exposure"""
    
    # Extract value
    value_match = re.search(r'₹[\d,]+|Rs[.\s]*[\d,]+|\$[\d,]+', contract_text)
    value = 100000
    if value_match:
        try:
            value = int(re.sub(r'[₹Rs\$,\s\.]', '', value_match.group()))
        except:
            pass
    
    # Calculate exposure
    multipliers = {"CRITICAL": 100, "HIGH": 10, "MEDIUM": 2, "LOW": 0.1}
    breakdown = []
    total = 0
    
    for r in risks:
        mult = multipliers[r.level]
        exposure = value * mult
        total += exposure
        breakdown.append({
            "risk": r.category,
            "level": r.level,
            "potential_loss": f"₹{exposure:,}",
            "explanation": r.description
        })
    
    return {
        "contract_value": f"₹{value:,}",
        "total_exposure": f"₹{total:,}",
        "risk_breakdown": breakdown,
        "recommendation": "DO NOT SIGN" if total > value*5 else "NEGOTIATE HARD" if total > value*2 else "ACCEPTABLE"
    }

