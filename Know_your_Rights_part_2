## 🧠 LAWYER PERSONALITY MODES
def analyze_with_personality(contract_text: str, mode: str = "balanced") -> str:
    """Get analysis from different lawyer perspectives"""
    
    modes = {
        "aggressive": "You're a SHARK lawyer. Every clause is a lawsuit. Be paranoid.",
        "conservative": "You're cautious, prioritizing client protection. Risk-averse.",
        "balanced": "You're pragmatic, balancing risk vs reality. Fair.",
        "startup": "You're a startup lawyer. Move fast but stay protected."
    }
    
    prompt = f"""{modes.get(mode, modes['balanced'])}

Analyze:
{contract_text[:1500]}

Your take:
1. First impression
2. Top 3 concerns  
3. Sign or not?

Stay in character."""
    
    model = genai.GenerativeModel(Config.GEMINI_MODEL)
    resp = model.generate_content(prompt)
    
    icons = {"aggressive": "🦈", "conservative": "🛡️", "balanced": "⚖️", "startup": "🚀"}
    return f"""{'='*80}
{icons[mode]} {mode.upper()} LAWYER
{'='*80}

{resp.text}

{'='*80}"""

