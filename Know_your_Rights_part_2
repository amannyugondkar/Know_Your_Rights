## 🔄 CONTRACT COMPARISON
def compare_contracts(contract1: str, contract2: str) -> str:
    """Compare two contracts"""
    
    model = genai.GenerativeModel(Config.GEMINI_MODEL)
    prompt = f"""Compare these contracts:

CONTRACT A:
{contract1[:1500]}

CONTRACT B:
{contract2[:1500]}

Provide:
1. Key Differences
2. Which is Better (A or B) and why
3. Unique Red Flags
4. RECOMMENDATION: Sign A, B, or neither"""
    
    resp = model.generate_content(prompt)
    return f"""{'='*80}
🔄 CONTRACT COMPARISON
{'='*80}

{resp.text}

{'='*80}"""

