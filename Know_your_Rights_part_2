## 🎯 CLAUSE-BY-CLAUSE ANALYSIS
def analyze_clause_by_clause(contract_text: str) -> str:
    """Analyze each clause separately"""
    
    clauses = []
    lines = contract_text.split('\n')
    current = {"num": "", "title": "", "text": ""}
    
    for line in lines:
        if re.match(r'^\d+\.?\s+[A-Z]', line.strip()):
            if current["text"]:
                clauses.append(current.copy())
            parts = line.split('.', 1)
            current = {"num": parts[0].strip(), "title": parts[1].strip() if len(parts)>1 else "", "text": ""}
        else:
            current["text"] += line + "\n"
    
    if current["text"]:
        clauses.append(current)
    
    # Analyze each
    model = genai.GenerativeModel(Config.GEMINI_MODEL)
    output = ["="*80, "📋 CLAUSE-BY-CLAUSE BREAKDOWN", "="*80]
    
    for c in clauses:
        output.append(f"\nCLAUSE {c['num']}: {c['title']}")
        output.append("─"*80)
        
        prompt = f"""Explain this contract clause in simple terms:
{c['title']}: {c['text'][:300]}

Provide (brief):
1. Plain English (2 sentences)
2. Risk: SAFE/CAUTION/DANGER
3. Your Rights
4. Negotiation Tip"""
        
        resp = model.generate_content(prompt)
        output.append(resp.text)
    
    return "\n".join(output)

print("✅ Clause analyzer ready!")
## 🤝 NEGOTIATION PLAYBOOK
def generate_negotiation_playbook(risks: List[Risk]) -> str:
    """Generate negotiation strategies"""
    
    model = genai.GenerativeModel(Config.GEMINI_MODEL)
    playbook = ["="*80, "🎯 NEGOTIATION PLAYBOOK", "="*80]
    playbook.append("\n💡 Strategy: Start with OPENING, settle for FALLBACK, walk at RED LINE\n")
    
    for i, risk in enumerate(risks, 1):
        playbook.append(f"\nISSUE #{i}: {risk.category}")
        playbook.append("─"*80)
        
        prompt = f"""Negotiation expert advice for:
RISK: {risk.category}
ISSUE: {risk.description}

Provide:
1. OPENING: Bold initial demand
2. FALLBACK: Acceptable compromise  
3. RED LINE: Walk away if crossed
4. EXACT WORDING: Clause language

Be specific."""
        
        resp = model.generate_content(prompt)
        playbook.append(resp.text)
    
    playbook.append("\n" + "="*80)
    playbook.append("💪 TIPS: Always negotiate via email. Be willing to walk away.")
    playbook.append("="*80)
    
    return "\n".join(playbook)

